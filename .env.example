# Gemini API key used by the Vizualabs Assistant chat widget and project
# estimator (src/lib/assistant/). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cal.com booking link used by the /book page (src/lib/cal.ts).
# Format: your-username/event-type — e.g. "vizualabs/strategy-session"
# Without it, the booking page shows a mailto fallback.
VITE_CAL_LINK=

# Resend API key for the contact form (src/lib/submitLead.ts).
# Free — sign up at https://resend.com, create a key under API Keys.
# Without it, the contact form shows an honest "not configured" error
# instead of a fake success message.
RESEND_API_KEY=

# Where contact-form leads get emailed. Optional — defaults to
# info@vizualabs.com if unset (the only Vizualabs inbox).
# Until you verify a domain at https://resend.com/domains, Resend only
# delivers to the email on your Resend account — keep this as info@vizualabs.com.
LEAD_NOTIFICATION_EMAIL=

# Sender address for lead emails. Optional — defaults to Resend's sandbox
# sender (onboarding@resend.dev). After verifying your domain, set e.g.
# RESEND_FROM_EMAIL="Vizualabs <noreply@vizualabs.com>"
RESEND_FROM_EMAIL=
