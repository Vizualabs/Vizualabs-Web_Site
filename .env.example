# Anthropic API key used by the Vizualabs Assistant chat widget (src/lib/assistant/chat.server.ts).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cal.com booking link used by every "Book a call" CTA (src/components/ui/BookingModal.tsx).
# Format: your-username/event-type — e.g. "vizualabs/strategy-session"
# Without it, the booking modal falls back to a plain mailto link.
VITE_CAL_LINK=

# PostHog analytics (src/lib/analytics.ts). Without a key, CTA/form events
# are logged to the console in dev and dropped in production.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Resend API key for the contact form (src/lib/submitLead.ts).
# Free — sign up at https://resend.com, create a key under API Keys.
# Without it, the contact form shows an honest "not configured" error
# instead of a fake success message.
RESEND_API_KEY=

# Where contact-form leads get emailed. Optional — defaults to
# info.vizualabs@gmail.com if unset.
LEAD_NOTIFICATION_EMAIL=

# Sender address for lead emails. Optional — defaults to Resend's sandbox
# sender (onboarding@resend.dev), which works with no domain setup. Switch
# to an address on your own domain once you verify one with Resend.
RESEND_FROM_EMAIL=
