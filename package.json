{
  "name": "vizualbs-official-website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:sitemap": "bun scripts/generate-sitemap.ts",
    "build": "bun run generate:sitemap && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker:dev": "bun --cwd workers/api run dev",
    "worker:deploy": "bun --cwd workers/api run deploy"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "feral-blob": "^0.1.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.21.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "patchedDependencies": {
    "feral-blob@0.1.0": "patches/feral-blob@0.1.0.patch"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
